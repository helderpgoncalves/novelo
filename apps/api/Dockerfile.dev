# syntax=docker/dockerfile:1.7
# Desenvolvimento: dependências na imagem, código por bind mount, hot reload.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.10 /uv /uvx /bin/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    PATH="/opt/venv/bin:$PATH" PYTHONPATH=/app/src PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && uvicorn novelo.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir /app/src"]
