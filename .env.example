# ============================================================================
# Novelo: variáveis de ambiente
#   cp .env.example .env     (o .env nunca vai para o Git)
# Em produção os valores vivem no Coolify (Environment Variables), não num ficheiro.
# ============================================================================

# --- Geral -------------------------------------------------------------------
APP_ENV=development                 # development | production
LOG_LEVEL=info
DOMAIN=novelo.helder.si         # só produção: domínio único (web + /api)

# --- Portas no host (dev) ------------------------------------------------------
WEB_PORT=3190
API_PORT=8190
DB_PORT=5590
OSRM_PORT=5000

# --- Base de dados (Postgres) --------------------------------------------------
POSTGRES_USER=novelo
POSTGRES_PASSWORD=novelo            # em produção: gerar uma password forte
POSTGRES_DB=novelo

# --- Sessão e autenticação -----------------------------------------------------
# Em produção o Coolify gera a SECRET_KEY (SERVICE_PASSWORD_64_SECRETKEY); aqui é só para dev.
SECRET_KEY=dev-only-change-me-dev-only-change-me
APP_URL=http://localhost:3190       # URL público do web (links dos emails, callback do Google)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30        # com "manter sessão iniciada"
SESSION_TOKEN_HOURS=24              # sem "manter sessão iniciada"
PASSWORD_RESET_EXPIRE_MINUTES=60
EMAIL_VERIFY_EXPIRE_HOURS=48
RATE_LIMIT_ENABLED=true             # limite de pedidos nas rotas de autenticação (desligado no compose de dev)
ALLOW_REGISTRATION=true             # false = só entram contas já existentes
# Administrador inicial, criado no arranque se não existir:
ADMIN_EMAIL=admin@heldergoncalves.io
ADMIN_PASSWORD=admin-novelo-dev-1

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) -----------
# Tipo "Web application". URIs de redirecionamento autorizados:
#   dev   http://localhost:3190/api/v1/auth/google/callback
#   prod  https://novelo.helder.si/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email transacional: Resend (https://resend.com/api-keys) ------------------
# Sem chave, os emails (recuperar password, confirmar email) aparecem no log: `just logs api`.
# O domínio do EMAIL_FROM tem de estar verificado no Resend.
RESEND_API_KEY=
EMAIL_FROM=Novelo <novelo@heldergoncalves.io>
EMAIL_SUPPORT=novelo@heldergoncalves.io  # ajuda no rodapé dos emails

# --- IA: OpenRouter (https://openrouter.ai/keys) -----------------------------
# Sem chave a API arranca e as features de IA ("E se...?", triagem) respondem 503.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Slugs em https://openrouter.ai/models; confirmar antes de fixar.
LLM_MODEL_TEXT=openai/gpt-6-luna                 # copiloto, "E se...?", explicações, briefing, alertas
LLM_MODEL_VISION=openai/gpt-6-luna                # triagem por foto (tem de aceitar imagens)
LLM_TIMEOUT_S=30
# Valores iniciais; o painel de administração (/admin/ai) guarda as escolhas na base de dados e manda sobre estes.
LLM_MODEL_FALLBACK=                              # modelo de reserva se o principal falhar (vazio = sem reserva)
LLM_MAX_OUTPUT_TOKENS=0                          # 0 = limite por tarefa definido no código
LLM_REASONING_EFFORT=low
LLM_MONTHLY_BUDGET_USD=0                         # 0 = sem limite; com valor, a IA pára ao atingi-lo
LLM_MAX_CONCURRENCY=4
LLM_CHAT_TIMEOUT_S=90
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_S=0.5

# --- Otimização e rotas --------------------------------------------------------
SOLVER_TIME_LIMIT_S=20
OSRM_URL=http://osrm:5000           # serviço osrm do compose (opcional no MVP)

# --- Web -----------------------------------------------------------------------
# Vazio = mesmo domínio (o nginx do web encaminha /api). Só definir para apontar a outra API.
VITE_API_URL=
# Mapa de base (style.json do MapLibre). Por omissão: CARTO Positron/Dark Matter, sem chave.
VITE_MAP_STYLE_LIGHT=
VITE_MAP_STYLE_DARK=
