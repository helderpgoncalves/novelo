{
  "components": {
    "schemas": {
      "AuthConfig": {
        "properties": {
          "google_enabled": {
            "title": "Google Enabled",
            "type": "boolean"
          },
          "password_min_length": {
            "default": 10,
            "title": "Password Min Length",
            "type": "integer"
          },
          "registration_open": {
            "title": "Registration Open",
            "type": "boolean"
          }
        },
        "required": [
          "google_enabled",
          "registration_open"
        ],
        "title": "AuthConfig",
        "type": "object"
      },
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Password"
          },
          "new_password": {
            "maxLength": 128,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": [
          "new_password"
        ],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "Circuit": {
        "properties": {
          "circuit": {
            "title": "Circuit",
            "type": "string"
          },
          "collection_type": {
            "title": "Collection Type",
            "type": "string"
          },
          "days": {
            "title": "Days",
            "type": "string"
          },
          "localities": {
            "items": {
              "type": "string"
            },
            "title": "Localities",
            "type": "array"
          },
          "note": {
            "title": "Note",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "typology": {
            "title": "Typology",
            "type": "string"
          }
        },
        "required": [
          "typology",
          "circuit",
          "collection_type",
          "localities",
          "days",
          "status",
          "note"
        ],
        "title": "Circuit",
        "type": "object"
      },
      "CircuitsSummary": {
        "properties": {
          "circuits": {
            "items": {
              "$ref": "#/components/schemas/Circuit"
            },
            "title": "Circuits",
            "type": "array"
          },
          "localities": {
            "items": {
              "type": "string"
            },
            "title": "Localities",
            "type": "array"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          },
          "vehicles": {
            "title": "Vehicles",
            "type": "integer"
          },
          "vehicles_never_assigned": {
            "items": {
              "type": "string"
            },
            "title": "Vehicles Never Assigned",
            "type": "array"
          },
          "without_vehicle": {
            "title": "Without Vehicle",
            "type": "integer"
          }
        },
        "required": [
          "circuits",
          "total",
          "without_vehicle",
          "vehicles",
          "vehicles_never_assigned",
          "localities"
        ],
        "title": "CircuitsSummary",
        "type": "object"
      },
      "EntityBaseline": {
        "description": "Têxtil recolhido por uma entidade em 2025 e destino final (toneladas).",
        "properties": {
          "entity": {
            "title": "Entity",
            "type": "string"
          },
          "exact_weights": {
            "description": "False se o destino vem de percentagens do relatório",
            "title": "Exact Weights",
            "type": "boolean"
          },
          "recycle_pct": {
            "title": "Recycle Pct",
            "type": "number"
          },
          "recycle_t": {
            "title": "Recycle T",
            "type": "number"
          },
          "reject_pct": {
            "title": "Reject Pct",
            "type": "number"
          },
          "reject_t": {
            "title": "Reject T",
            "type": "number"
          },
          "reuse_pct": {
            "title": "Reuse Pct",
            "type": "number"
          },
          "reuse_t": {
            "title": "Reuse T",
            "type": "number"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "total_t": {
            "title": "Total T",
            "type": "number"
          }
        },
        "required": [
          "entity",
          "total_t",
          "reuse_t",
          "recycle_t",
          "reject_t",
          "reuse_pct",
          "recycle_pct",
          "reject_pct",
          "source",
          "exact_weights"
        ],
        "title": "EntityBaseline",
        "type": "object"
      },
      "FlowLink": {
        "properties": {
          "source": {
            "title": "Source",
            "type": "string"
          },
          "target": {
            "title": "Target",
            "type": "string"
          },
          "tonnes": {
            "title": "Tonnes",
            "type": "number"
          }
        },
        "required": [
          "source",
          "target",
          "tonnes"
        ],
        "title": "FlowLink",
        "type": "object"
      },
      "FlowNode": {
        "properties": {
          "column": {
            "title": "Column",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "column"
        ],
        "title": "FlowNode",
        "type": "object"
      },
      "Flows": {
        "properties": {
          "links": {
            "items": {
              "$ref": "#/components/schemas/FlowLink"
            },
            "title": "Links",
            "type": "array"
          },
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/FlowNode"
            },
            "title": "Nodes",
            "type": "array"
          },
          "observed": {
            "title": "Observed",
            "type": "boolean"
          }
        },
        "required": [
          "observed",
          "nodes",
          "links"
        ],
        "title": "Flows",
        "type": "object"
      },
      "ForgotPasswordRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "ForgotPasswordRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "database": {
            "title": "Database",
            "type": "boolean"
          },
          "llm_enabled": {
            "title": "Llm Enabled",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "llm_enabled"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "password": {
            "maxLength": 128,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "ResetPasswordRequest": {
        "properties": {
          "password": {
            "maxLength": 128,
            "title": "Password",
            "type": "string"
          },
          "token": {
            "maxLength": 200,
            "minLength": 20,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "title": "ResetPasswordRequest",
        "type": "object"
      },
      "TextileBaseline": {
        "properties": {
          "capture_of_demand_pct": {
            "title": "Capture Of Demand Pct",
            "type": "number"
          },
          "entities": {
            "items": {
              "$ref": "#/components/schemas/EntityBaseline"
            },
            "title": "Entities",
            "type": "array"
          },
          "estimated_demand_t": {
            "description": "Estimativa do plano municipal: 0,7 kg/hab/mês",
            "title": "Estimated Demand T",
            "type": "number"
          },
          "gap_t": {
            "title": "Gap T",
            "type": "number"
          },
          "kg_per_inhab_month": {
            "description": "Observado: toneladas recolhidas por habitante",
            "title": "Kg Per Inhab Month",
            "type": "number"
          },
          "population": {
            "title": "Population",
            "type": "integer"
          },
          "recycle_t": {
            "title": "Recycle T",
            "type": "number"
          },
          "reject_t": {
            "title": "Reject T",
            "type": "number"
          },
          "reuse_t": {
            "title": "Reuse T",
            "type": "number"
          },
          "total_t": {
            "title": "Total T",
            "type": "number"
          },
          "year": {
            "default": 2025,
            "title": "Year",
            "type": "integer"
          }
        },
        "required": [
          "population",
          "entities",
          "total_t",
          "reuse_t",
          "recycle_t",
          "reject_t",
          "kg_per_inhab_month",
          "estimated_demand_t",
          "capture_of_demand_pct",
          "gap_t"
        ],
        "title": "TextileBaseline",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "google_linked": {
            "title": "Google Linked",
            "type": "boolean"
          },
          "has_password": {
            "title": "Has Password",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "role": {
            "enum": [
              "admin",
              "operator"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "avatar_url",
          "role",
          "has_password",
          "google_linked"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Novelo API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/change-password": {
      "post": {
        "operationId": "change_password",
        "parameters": [
          {
            "in": "cookie",
            "name": "access_token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Access Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Change Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/config": {
      "get": {
        "description": "O que o ecrã de entrada precisa de saber: Google ligado? registo aberto?",
        "operationId": "get_auth_config",
